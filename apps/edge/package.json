{
  "name": "edge",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy --env production",
    "spike:deploy": "wrangler deploy --config spike/wrangler.jsonc",
    "spike:deploy:zone": "wrangler deploy --config spike/wrangler.jsonc --route \"spike.lofty.page/*\"",
    "spike:check": "vpx spike/check.ts",
    "spike:delete": "wrangler delete --config spike/wrangler.jsonc"
  },
  "dependencies": {
    "@workspace/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "catalog:",
    "vite-plus": "catalog:"
  }
}
