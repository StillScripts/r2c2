# Copy to .env.local and fill in. See SPEC §8.

# Convex deployment URL (.convex.cloud), used by the browser client
VITE_CONVEX_URL=
# Convex HTTP actions URL (.convex.site). The Loft's server forwards /api/auth/* to
# it and reads the sign-in token from it. The deployment's SITE_URL must be this
# app's origin (http://localhost:3000 in dev).
CONVEX_SITE_URL=
