# Copy to .env.local, or run `vp run --filter @workspace/backend dev` to choose a
# deployment. See SPEC §8.

# Convex deployment the CLI pushes to, e.g. dev:tangible-bear-808
CONVEX_DEPLOYMENT=

# Secrets below live on the Convex deployment, not in this file:
#   npx convex env set <NAME> <value>
# Each deployment gets its own bucket and KV namespace (dev: r2c2-dev and R2C2_ROUTES_DEV).
#
# R2, from an R2 API token with Object Read & Write on the bucket:
#   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ENDPOINT, R2_BUCKET
# KV sync, from an API token with only Workers KV Storage: Edit:
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_KV_NAMESPACE_ID
